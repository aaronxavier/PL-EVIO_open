<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>evio_estimator</name>
  <version>2.0.0</version>
  <description>PL-EVIO sliding-window VIO back end: IMU preintegration + Ceres optimization over point and line visual residuals.</description>
  <maintainer email="aaronxavier999@gmail.com">PL-EVIO</maintainer>
  <license>GPLv3</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <depend>camera_model</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
