<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>feature_tracker</name>
  <version>2.0.0</version>
  <description>PL-EVIO event and image point+line feature tracking (ArcStar corner detector, time surface, KLT optical flow, LSD line matching).</description>
  <maintainer email="aaronxavier999@gmail.com">PL-EVIO</maintainer>
  <license>GPLv3</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>camera_model</depend>
  <depend>dvs_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
